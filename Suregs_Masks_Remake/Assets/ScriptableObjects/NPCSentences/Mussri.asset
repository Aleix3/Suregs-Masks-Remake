  isCommerceDialogue: 0
  sentences:
  - text: "\xBFOtra m\xE1scara m\xE1s? No s\xE9 si podr\xE9 cargar con todas..."
    id: 0
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "Carne fresca al fin, empezaba a estar cansado del otro cuerpo, seguro
      que t\xFA me saciar\xE1s."
    id: 0
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "\xBFOtro cuerpo? \xBFCarne fresca? No entiendo nada... Y de nuevo no contesta..."
    id: 0
    type: 0
    minState: 0
    options: []
