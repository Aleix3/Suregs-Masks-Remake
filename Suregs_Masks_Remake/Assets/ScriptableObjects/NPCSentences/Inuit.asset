  sentences:
  - text: "\xBFOtra m\xE1scara m\xE1s?"
    id: 0
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "Eres m\xE1s fuerte de lo que pensaba, nadie hab\xEDa llegado solo hasta
      aqu\xED. \xDAnete a m\xED y juntos seremos m\xE1s que ellos."
    id: 0
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "\xBFEllos? \xBFQui\xE9nes son ellos? \xBFMe oyes? No contesta..."
