%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9dbf4bb952f694409fe53dd8afb006f, type: 3}
  m_Name: Igorv2
  m_EditorClassIdentifier: 
  npcName: Igorv
  portrait: {fileID: 21300000, guid: 1d720524026e44f4698d2895aa08f141, type: 3}
  isCommerceDialogue: 0
  sentences:
  - text: "Jakov?? Que haces aqui?? \xBFQu\xE9 ha pasado?"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "\xBFPadre\u2026 \xBFQu\xE9 has hecho?... Todos estos a\xF1os, solo, ha
      sido tu culpa, desapareciste cuando m\xE1s te necesitaba, me abandonaste\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "Lo hice por nosotros, por recuperar nuestra familia, solo quer\xEDa traer
      de vuelta a Alma."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "\xBFTraerla de vuelta? Ha acabado muerta, por ti."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "No es lo que te imaginas, madre no muri\xF3 a mis manos, fue la negligencia
      del pueblo lo que acab\xF3 con ella, fue culpa suya."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "\xBFY qu\xE9 hay de tus compa\xF1eros?, murieron a tus manos."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "Eran demasiado d\xE9biles, no estaban preparados\u2026 murieron por un
      bien mayor\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
  - text: "\xBFC\xF3mo? Son mis m\xE1s fieles guerreros, yo nunca les dejar\xEDa
      morir."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "\u2026 Y qu\xE9 hay de la abuela? Ni te imaginas lo que ha sufrido por
      ti."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "Esa vieja entrometida\u2026 siempre metiendo su nariz en asuntos ajenos."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
  - text: "Ser\xE1s\u2026S\xE9 que este no eres t\xFA\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "No s\xE9 que est\xE1 pasando, todo esto nunca fue mi intenci\xF3n, dar\xEDa
      lo que fuera por haberte visto crecer."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: ...
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: Jakov
    speakerPortrait: {fileID: 21300000, guid: 40396ffe27ad7ad47bd54e7338e884c1, type: 3}
  - text: "La m\xE1scara me ha hablado, me ha prometido devolverle la vida a Alma\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "solo necesitamos el poder de todas las m\xE1scaras\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
  - text: "as\xED podr\xEDamos honrar la memoria de madre"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "acabemos con aquellos que nos la arrebataron, aquellos que nunca confiaron
      en ti\u2026"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
  - text: "es tan solo un peque\xF1o sacrificio"
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 0
    speakerName: 
    speakerPortrait: {fileID: 0}
  - text: "\xFAnete a nosotros."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
  - text: "a m\xED!"
    id: 
    type: 1
    minState: 0
    options:
    - optionText: Matar a padre.
      nextSentences:
      - text: 
        id: 0
        type: 6
        minState: 0
        options: []
        commerceID: 0
        overrideSpeaker: 0
        speakerName: 
        speakerPortrait: {fileID: 0}
    - optionText: Unirme a padre.
      nextSentences:
      - text: 
        id: 1
        type: 6
        minState: 0
        options: []
        commerceID: 0
        overrideSpeaker: 0
        speakerName: 
        speakerPortrait: {fileID: 0}
    commerceID: 0
    overrideSpeaker: 1
    speakerName: "M\xE1scara"
    speakerPortrait: {fileID: 21300000, guid: fbdc993349c2cf2429079cae5752286b, type: 3}
