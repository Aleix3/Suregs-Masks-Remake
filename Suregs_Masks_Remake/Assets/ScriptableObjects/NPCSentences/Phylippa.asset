%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9dbf4bb952f694409fe53dd8afb006f, type: 3}
  m_Name: Phylippa
  m_EditorClassIdentifier: 
  npcName: Phylippa
  portrait: {fileID: 21300000, guid: aa5c4e0014e4a3c4d9cce5bc69eee392, type: 3}
  sentences:
  - text: "Hola Jakhov, \xBFvas al entreno? Mira que bien... "
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "Nada, nada, ves r\xE1pido, yo estoy aqu\xED viendo que tal est\xE1 Zuphu..."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "No entiendo porque siempre se tiene que poner el m\xE1s alejado del pueblo..."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "\xBFYa vuelves? Que bien, je, je, je..."
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: "Zuphu a\xFAn no vuelve, no s\xE9 porque siempre vuelve tarde..."
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: Que ganas tengo de irme de esta aldea llena de peligros...
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: "\xBFHas ido hacia la cueva? Me lo ha dicho Zuphu hoy..."
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: No me puedo creer que hagas estas cosas...
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: "Yo me volver\xEDa loca si a Zuphu se le ocurre hacer algo as\xED..."
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: "Me ha dicho Zuphu que sueles ir cada d\xEDa por la cueva..."
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: "Ten mucho cuidado, \xBFvale? Aunque me ha dicho que seguramente salgas
      al instante..."
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: Si entrenas en el bosque no es necesario hacer esto...
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: "Hola Jakov, parece que ves t\xFA m\xE1s a mi marido que yo misma..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "\xBFC\xF3mo estaba hoy? Espero que le fuese bien..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "A ver si le puedes convencer de ponerse m\xE1s cerca del pueblo..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "Oye, parece que est\xE1s entrenando duro, se ven los resultados..."
    id: 
    type: 0
    minState: 5
    options: []
    commerceID: 0
  - text: "A\xFAn me acuerdo cuando Zuphu era joven.."
    id: 
    type: 0
    minState: 5
    options: []
    commerceID: 0
  - text: "Tambi\xE9n tuvo una \xE9poca as\xED con sus hermanos..."
    id: 
    type: 0
    minState: 5
    options: []
    commerceID: 0
  - text: "\xA1Que mala cara Jakov! Tienes una cara de cansado..."
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: Tienes que dormir bien, yo a Zuphu le hago leche con miel para que duerma...
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: "Aunque esto no se lo digas a nadie, que le da verg\xFCenza..."
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: Hoy me he enfadado con Zuphu...
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "Esta ma\xF1ana se ha ido sin decirme ni adi\xF3s..."
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "No s\xE9 que le debe pasar, lo noto muy ap\xE1tico desde hace d\xEDas..."
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "\xA1Hombre Jakov! \xBFHas escuchado de la boda de Patzo y Patza? Que ilusi\xF3n..."
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
  - text: "Me recuerda un mont\xF3n a la boda que tuve con Zuphu..."
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
  - text: "Que recuerdos me trae, \xA1ay Dios m\xEDo! Que ilusi\xF3n..."
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
