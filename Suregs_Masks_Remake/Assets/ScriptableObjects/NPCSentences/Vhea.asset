MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9dbf4bb952f694409fe53dd8afb006f, type: 3}
  m_Name: Vhea
  m_EditorClassIdentifier: 
  npcName: Vhea
  portrait: {fileID: 21300000, guid: 7ca1df1348f4b7e4397493b00c3b4a9b, type: 3}
  sentences:
  - text: "Buenos d\xEDas cari\xF1o, \xBFotra vez la misma pesadilla?"
    id: 
    type: 1
    minState: 0
    options:
    - optionText: Si lo mismo de siempre, prefiero no hablar de ello...
      nextSentences:
      - text: Vaya...
        id: 
        type: 0
        minState: 0
        options: []
        commerceID: 0
    commerceID: 0
  - text: "Bueno... \xBFHoy tienes entrenamiento verdad?"
    id: 
    type: 1
    minState: 0
    options:
    - optionText: "S\xED, debo ir al campamento"
      nextSentences:
      - text: "Perfecto, recuerda que est\xE1 al norte del pueblo."
        id: 
        type: 0
        minState: 0
        options: []
        commerceID: 0
    - optionText: "\xBFC\xF3mo qu\xE9 entrenamiento?"
      nextSentences:
      - text: "S\xED, tienes que ir al campamento que est\xE1 al norte del pueblo."
        id: 
        type: 0
        minState: 0
        options: []
        commerceID: 0
    commerceID: 0
  - text: "\xBFQue tal ha ido el entrenamiento?"
    id: 
    type: 1
    minState: 1
    options:
    - optionText: "Hola Abuela, otro entrenamiento nefasto, tendr\xEDa que ser m\xE1s
        fuerte, como padre..."
      nextSentences:
      - text: "Eso fue justo lo que le mat\xF3, Jakov, no sab\xEDa cuando parar."
        id: 
        type: 0
        minState: 1
        options: []
        commerceID: 0
    commerceID: 0
  - text: "Y t\xFA no tienes que parecerte a \xE9l, seguro que se te dan bien otros
      trabajos..."
    id: 
    type: 1
    minState: 1
    options:
    - optionText: "Seguro que ten\xEDa alg\xFAn secreto para ser tan fuerte... Abuela,
        \xBFd\xF3nde guardas su equipo? Seguro que hay algo que me sirve..."
      nextSentences:
      - text: "Ni se te ocurra, seguir sus pasos te va a llevar a un camino muy oscuro,
          no lo pienses m\xE1s, come esto y descansa."
        id: 
        type: 0
        minState: 1
        options: []
        commerceID: 0
    commerceID: 0
  - text: "Que mal te ves Jakov, \xBFquieres comer y reponer fuerzas?"
    id: 
    type: 1
    minState: 2
    options:
    - optionText: Si, por favor.
      nextSentences:
      - text: "C\xF3melo tranquilo, est\xE1 reci\xE9n hecho."
        id: 
        type: 0
        minState: 1
        options: []
        commerceID: 0
    - optionText: No hace falta.
      nextSentences:
      - text: "Bueno... Estar\xE9 siempre aqu\xED si necesitas algo de comer."
        id: 
        type: 0
        minState: 1
        options: []
        commerceID: 0
    commerceID: 0
