%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9dbf4bb952f694409fe53dd8afb006f, type: 3}
  m_Name: Hemyl
  m_EditorClassIdentifier: 
  npcName: Hemyl
  portrait: {fileID: 21300000, guid: cc494c6b5d87b9a4b9c8d04fdaa3d920, type: 3}
  sentences:
  - text: "\xA1Qu\xE9 madrug\xF3n Jakov! \xBFVas a entrenar tan pronto? Que madrug\xF3n..."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "\xA1Hay que ver c\xF3mo te esfuerzas! Por cierto, \xBFantes de salir puedes
      darle esto a tu abuela? Es importante..."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "No te molesto m\xE1s, ya puedes ir a entrenar..."
    id: 
    type: 0
    minState: 0
    options: []
    commerceID: 0
  - text: "\xBFYa has terminado? Te veo un poco apagado, espero que no te haya pasado
      nada mientras entrenabas..."
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: "Recuerda darle recuerdos a Vhea, ma\xF1ana os llevar\xE9 la compra, es
      una pena que desde entonces no quiera salir de casa..."
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: Cuidala mucho Jakhov, cuando te haces mayor empiezas a entender que la
      vida es muy corta, no te vayas de este mundo con remordimientos...
    id: 
    type: 0
    minState: 1
    options: []
    commerceID: 0
  - text: "\xA1Jakhov! Se ha corrido la voz por todo el pueblo de que te has metido
      a la cueva del demonio..."
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: "Ya sabes que yo siempre te apoyar\xE9 en lo que hagas, y si este es el
      camino que has escogido, no hay alternativa..."
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: "Pero piensa en las consecuencias de todo Jakhov, tu padre era igual y
      ya viste como termin\xF3 todo, recuerda que no puedes dejar a tu abuela sola..."
    id: 
    type: 0
    minState: 2
    options: []
    commerceID: 0
  - text: "\xA1Vaya! Que hablador te has vuelto, jovencito. Normalmente ibas siempre
      a entrenar con el ce\xF1o fruncido, que miedo..."
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: "Me gusta como eres ahora, te ves m\xE1s confiado y m\xE1s... Como decirlo...
      Confiable..."
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: "Te empiezas a parecer a tu padre chico, \xA1Ja, ja, ja! Aunque, desde
      luego, pareces bastante menos so\xF1ador que \xE9l..."
    id: 
    type: 0
    minState: 3
    options: []
    commerceID: 0
  - text: "\xA1Oye! \xBFHas estado entrenando fuera del campo de entrenamiento? Te
      veo mucho m\xE1s fuerte..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "He pasado algunos d\xEDas por el campo a la hora de siempre y no te he
      visto, sabes que si pasa algo me lo puedes contar..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "Llevo desde que eras un ni\xF1o contigo Jakhov, le promet\xED a tu abuelo
      que cuidar\xEDa de Vhea y su descendencia si \xE9l no estaba..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "Llevo desde que eras un ni\xF1o contigo Jakhov, le promet\xED a tu abuelo
      que cuidar\xEDa de Vhea y su descendencia si \xE9l no estaba..."
    id: 
    type: 0
    minState: 4
    options: []
    commerceID: 0
  - text: "Hola Jakhov, \xBFquieres algo? Llevas un tiempo diferente, desde luego,
      eres m\xE1s fuerte, m\xE1s amable y m\xE1s hablador..."
    id: 
    type: 1
    minState: 5
    options:
    - optionText: "- \xBFQue relaci\xF3n tienes con mi abuela?"
      nextSentences: []
    commerceID: 0
  - text: "\xA1Vaya! As\xED que es eso. \xA1Ja, ja ja! Si quieres saber que relaci\xF3n
      tengo con tu abuela, deber\xEDas preguntarselo a ella, seguro que su respuesta
      te gustar\xE1..."
    id: 
    type: 0
    minState: 5
    options: []
    commerceID: 0
  - text: "\xBFQue pasa con esa cara Jakhov? Tienes las mismas expresiones que tu
      padre, \xA1ja, ja, ja! Siempre con una sonrisa y con cara de pocos amigos... "
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: "Sabes que yo no digo nada, pero creo que algunas personas de la aldea
      han descubierto tu peque\xF1o secreto sobre la cueva..."
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: "Yo te dije que hac\xEDa tiempo que te ve\xEDa en el campo de entrenamiento,
      si yo me d\xED cuenta, ya te puedes imaginar los otros estudiantes de caballero..."
    id: 
    type: 0
    minState: 6
    options: []
    commerceID: 0
  - text: "\xA1Vaya cara Jakhov! De verdad cada d\xEDa te veo m\xE1s preocupado por
      algo extra\xF1o..."
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "\xBFTiene algo que ver con aquella cueva? Te est\xE1 pasando lo mismo
      que a tu padre..."
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "Recuerda estar siempre cuerdo, \xBFvale? No s\xE9 realmente lo que sucede
      all\xED adentro, pero tienes que mantener la cabeza fr\xEDa..."
    id: 
    type: 0
    minState: 7
    options: []
    commerceID: 0
  - text: "Jakhov, \xBFrealmente sabes lo que est\xE1s haciendo? Todo el pueblo se
      ha enterado de lo de las mazmorras..."
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
  - text: "Sabes que yo te apoyar\xE9 en tu camino, pero deber\xEDas comprar una
      buena armadura y espadas para enfrentarte a lo que tu padre no pudo..."
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
  - text: Visita las tiendas del pueblo para comprar mejores opciones de combate,
      porfavor...
    id: 
    type: 0
    minState: 8
    options: []
    commerceID: 0
