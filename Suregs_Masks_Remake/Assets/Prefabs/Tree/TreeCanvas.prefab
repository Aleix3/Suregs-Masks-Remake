  maskData:
  - maskName: Dinka
    maskDesc: Lanza un rayo que resta 50 puntos de vida a un enemigo, cuenta con
      25 segundos de cooldown y puede producir veneno.Su pasiva aumenta el poder
      de ataque un 20%
    nodes:
    - upgradeName: Poder I
      upgradeDesc: Aumenta el poder de la habilidad principal a 80 puntos
      icon: {fileID: 21300000, guid: 4bcfd1b83cd454a468db1597f8a0eaef, type: 3}
    - upgradeName: Poder II
      upgradeDesc: Aumenta el poder de la habilidad principal a 130 puntos
      icon: {fileID: 21300000, guid: 4bcfd1b83cd454a468db1597f8a0eaef, type: 3}
    - upgradeName: Poder III
      upgradeDesc: Aumenta el poder de la habilidad principal a 200 puntos
      icon: {fileID: 21300000, guid: 4bcfd1b83cd454a468db1597f8a0eaef, type: 3}
    - upgradeName: Poder IV
      upgradeDesc: Aumenta el poder de la habilidad principal a 300 puntos
      icon: {fileID: 21300000, guid: 4bcfd1b83cd454a468db1597f8a0eaef, type: 3}
    - upgradeName: CoolDown I
      upgradeDesc: Reduce el cooldown de la habilidad principal a 23 segundos
      icon: {fileID: 21300000, guid: 15dcf2d7a95dfe3448aa01e444b24c63, type: 3}
    - upgradeName: CoolDown II
      upgradeDesc: Reduce el cooldown de la habilidad principal a 20 segundos
      icon: {fileID: 21300000, guid: 15dcf2d7a95dfe3448aa01e444b24c63, type: 3}
    - upgradeName: CoolDown III
      upgradeDesc: Reduce el cooldown de la habilidad principal a 17 segundos
      icon: {fileID: 21300000, guid: 15dcf2d7a95dfe3448aa01e444b24c63, type: 3}
    - upgradeName: CoolDown IV
      upgradeDesc: Reduce el cooldown de la habilidad principal a 15 segundos
      icon: {fileID: 21300000, guid: 15dcf2d7a95dfe3448aa01e444b24c63, type: 3}
    - upgradeName: Rayos I
      upgradeDesc: Aumenta la cantidad de rayos de la habilidad principal a 2
      icon: {fileID: 21300000, guid: b0fa1a91e867a934d840b299dd515dc1, type: 3}
    - upgradeName: Rayos II
      upgradeDesc: Aumenta la cantidad de rayos de la habilidad principal a 3
      icon: {fileID: 21300000, guid: b0fa1a91e867a934d840b299dd515dc1, type: 3}
    - upgradeName: Rayos III
      upgradeDesc: Aumenta la cantidad de rayos de la habilidad principal a 4
